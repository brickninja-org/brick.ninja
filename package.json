{
  "name": "brick.ninja",
  "private": true,
  "scripts": {
    "dev:web": "PNPM_VERIFY_DEPS_BEFORE_RUN=false FORCE_COLOR=1 turbo run dev --filter=web",
    "dev:worker": "PNPM_VERIFY_DEPS_BEFORE_RUN=false FORCE_COLOR=1 turbo run dev --filter=worker",
    "prisma:studio": "PNPM_VERIFY_DEPS_BEFORE_RUN=false pnpm run --filter @brickninja-org/database prisma:studio",
    "prisma:migrate-dev": "PNPM_VERIFY_DEPS_BEFORE_RUN=false pnpm run --filter @brickninja-org/database prisma:migrate-dev",
    "build": "PNPM_VERIFY_DEPS_BEFORE_RUN=false turbo run build",
    "build:icons": "PNPM_VERIFY_DEPS_BEFORE_RUN=false turbo run build --filter=@brickninja-org/icons",
    "lint": "PNPM_VERIFY_DEPS_BEFORE_RUN=false turbo run lint --continue -- -f gha",
    "publish-package": "PNPM_VERIFY_DEPS_BEFORE_RUN=false turbo run publish-package",
    "e2e": "PNPM_VERIFY_DEPS_BEFORE_RUN=false turbo run e2e",
    "test": "PNPM_VERIFY_DEPS_BEFORE_RUN=false turbo run test"
  },
  "devDependencies": {
    "@brickninja-org/publish-package": "workspace:*",
    "eslint-formatter-gha": "1.6.0",
    "turbo": "2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "20 || >=22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "10.17.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.17.1"
}
