{
  "name": "brick.ninja",
  "private": true,
  "scripts": {
    "dev:web": "FORCE_COLOR=1 turbo run dev --filter=web",
    "dev:worker": "FORCE_COLOR=1 turbo run dev --filter=worker",
    "prisma:studio": "pnpm run --filter @brickninja-org/database prisma:studio",
    "prisma:migrate-dev": "pnpm run --filter @brickninja-org/database prisma:migrate-dev",
    "build": "turbo run build",
    "build:icons": "turbo run build --filter=@brickninja-org/icons",
    "lint": "turbo run lint --continue -- -f gha",
    "publish-package": "turbo run publish-package",
    "e2e": "turbo run e2e",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@brickninja-org/publish-package": "workspace:*",
    "eslint-formatter-gha": "1.5.2",
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "20 || >=22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "9.15.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "@types/react": "19.0.6",
      "@types/react-dom": "19.0.3"
    }
  },
  "packageManager": "pnpm@9.15.3"
}
