{
  "name": "worker",
  "scripts": {
    "prisma": "prisma generate",
    "prebuild": "npm run clean && npm run types",
    "build": "npm run ncc",
    "dev": "node dist/index.js",
    "lint": "eslint src",
    "ncc": "ncc build src/index.ts --out dist --target es2023 --external sharp",
    "postncc": "mv dist/client/* dist/ && rm -r dist/client",
    "clean": "rm -rf dist",
    "types": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "@brickninja-org/database": "*",
    "@brickninja-org/helper": "*",
    "@brickset-api/fetch": "0.0.4",
    "@brickset-api/types": "0.0.3",
    "chalk": "5.3.0",
    "cron-parser": "4.9.0",
    "dotenv": "16.4.5",
    "fast-average-color-node": "3.0.0"
  },
  "devDependencies": {
    "@brickninja-org/eslint-config": "*",
    "@brickninja-org/tsconfig": "*",
    "@types/jest": "29.5.12",
    "@types/node": "20.16.3",
    "@typescript-eslint/eslint-plugin": "8.4.0",
    "@typescript-eslint/parser": "8.3.0",
    "@vercel/ncc": "0.38.1",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.5.4"
  }
}