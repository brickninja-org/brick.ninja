{
  "name": "worker",
  "scripts": {
    "prisma": "prisma generate",
    "prebuild": "pnpm run clean && pnpm run types",
    "build": "pnpm run ncc",
    "dev": "node dist/index.js",
    "lint": "eslint src",
    "ncc": "ncc build src/index.ts --out dist --target es2023 --external sharp",
    "postncc": "rm -rf dist/worker && cp ../../packages/database/.prisma/libquery_engine-* ../../packages/database/.prisma/schema.prisma dist",
    "clean": "rm -rf dist",
    "types": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "@brickninja-org/database": "workspace:*",
    "@brickninja-org/helper": "workspace:*",
    "@brickset-api/fetch": "0.0.18",
    "@brickset-api/types": "0.0.16",
    "@rebrickableapi/fetch": "0.0.5",
    "@rebrickableapi/types": "0.0.4",
    "chalk": "5.4.1",
    "cron-parser": "4.9.0",
    "dotenv": "16.4.7",
    "fast-average-color-node": "3.1.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@brickninja-org/eslint-config": "workspace:*",
    "@brickninja-org/tsconfig": "workspace:*",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.18.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.11",
    "@typescript-eslint/parser": "8.27.0",
    "@vercel/ncc": "0.38.3",
    "eslint": "9.18.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "typescript": "5.8.2"
  }
}
