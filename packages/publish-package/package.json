{
  "name": "@brickninja-org/publish-package",
  "version": "0.0.1-rc.0",
  "description": "brick.ninja publish package script",
  "bin": {
    "brickninja-publish-package": "bin/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist/",
    "lint": "eslint src",
    "dev": "pnpm run build && GITHUB_EVENT_NAME=pull_request node dist/index.js",
    "publish-package": "brickninja-publish-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brickninja-org/brick.ninja.git"
  },
  "keywords": [
    "brickninja",
    "publish-package"
  ],
  "files": [
    "dist/",
    "bin/"
  ],
  "author": "@brickninja",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brickninja-org/brick.ninja/issues"
  },
  "homepage": "https://github.com/brickninja-org/brick.ninja#readme",
  "devDependencies": {
    "@brickninja-org/eslint-config": "workspace:*",
    "@brickninja-org/tsconfig": "workspace:*",
    "@types/node": "22.15.34",
    "eslint": "9.30.1",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  }
}
