{
  "name": "@brickninja-org/helper",
  "version": "0.0.1",
  "description": "brick.ninja utility library",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && if test $CI; then pnpm run build:ci; else pnpm run build:local; fi",
    "build:local": "tsc --declarationMap",
    "build:ci": "tsc",
    "clean": "rm -rf dist/",
    "lint": "eslint src",
    "publish-package": "brickninja-publish-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brickninja-org/brick.ninja.git"
  },
  "keywords": [
    "brickninja",
    "helper"
  ],
  "files": [
    "dist/"
  ],
  "author": "@brickninja",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brickninja-org/brick.ninja/issues"
  },
  "homepage": "https://github.com/brickninja-org/brick.ninja#readme",
  "devDependencies": {
    "@brickninja-org/eslint-config": "workspace:*",
    "@brickninja-org/tsconfig": "workspace:*",
    "eslint": "9.24.0",
    "typescript": "5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}