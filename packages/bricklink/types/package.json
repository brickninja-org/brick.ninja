{
  "name": "@bricklink-api/types",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript types for all datastructures used by the Bricklink API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brickninja-org/bricklink-api-ts.git",
    "directory": "packages/types"
  },
  "exports": {
    "./endpoints": {
      "types": "./endpoints.ts"
    },
    "./data/*": {
      "types": "./data/*.ts"
    },
    "./schema": {
      "types": "./schema.ts"
    }
  },
  "keywords": [
    "bricklinkapi",
    "types",
    "bricklink",
    "api",
    "typescript"
  ],
  "scripts": {
    "test": "tsc",
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  },
  "publishConfig": {
    "access": "restricted"
  }
}